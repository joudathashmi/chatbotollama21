# Force LF line endings for all text files in the repo, regardless of the
# checking-out OS. Prevents the CRLF/LF drift that previously showed every
# file as "modified" in working trees on systems that converted to CRLF.
* text=auto eol=lf

# Belt-and-braces: explicit LF for source and config formats we ship.
*.py        text eol=lf
*.pyi       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.sh        text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
.gitignore  text eol=lf
.env.example text eol=lf
Dockerfile  text eol=lf
