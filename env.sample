# Sample environment for the MISA Intelligence API.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Set MISA_ENV=production on internet-facing hosts — that enables fail-closed
# defaults (CORS allowlist required, docs off, HSTS on, no plaintext bootstrap,
# malware backend required, Redis rate limits with multi-worker).

MISA_ENV=development

# --- Auth (JWT) ---
JWT_SECRET_KEY=replace-with-python-c-import-secrets-print-secrets-token-urlsafe-48
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
MISA_JWT_ISSUER=misa-intelligence-api
MISA_JWT_AUDIENCE=misa-intelligence-api

# Bootstrap account (local/dev only). Disable in production:
#   MISA_ALLOW_PLAINTEXT_BOOTSTRAP=false
# and provision bcrypt users via MISA_AUTH_USERS instead.
API_USERNAME=SmartChatbot
API_PASSWORD=change-me
MISA_ALLOW_PLAINTEXT_BOOTSTRAP=true
# Local demos: skip login entirely (refused when MISA_ENV=production)
# MISA_AUTH_DISABLED=true
# MISA_AUTH_DISABLED_USERNAME=local
MISA_BOOTSTRAP_ROLE=admin

# Named accounts (JSON). role: viewer | analyst | admin
# MISA_AUTH_USERS=[{"username":"alice","password_hash":"$2b$...","role":"analyst"}]

# --- CORS / HTTP hardening ---
# Production MUST set an explicit allowlist (no "*").
MISA_CORS_ALLOWED_ORIGINS=http://localhost:3000
MISA_ENABLE_DOCS=true
MISA_HSTS_ENABLED=false

# --- Rate limiting ---
# Use redis when MISA_WORKERS > 1 (required in production).
MISA_RATE_LIMIT_BACKEND=memory
# MISA_REDIS_URL=redis://localhost:6379/0

# --- Malware scan (business-card uploads) ---
# Production: MISA_MALWARE_SCAN_BACKEND=clamscan
MISA_MALWARE_SCAN_ENABLED=true
MISA_MALWARE_SCAN_BACKEND=none

# --- Database / OpenAI (fill for your environment) ---
# PG_HOST=localhost
# PG_USER=postgres
# PG_PASSWORD=
# OPENAI_API_KEY=

# --- Document library ---
MISA_DOCUMENTS_ENABLED=true
# memory | postgres  (tests use memory; production: postgres)
MISA_DOCUMENTS_BACKEND=postgres
MISA_DOCUMENTS_ROOT=data/documents
MISA_DOCUMENTS_INGEST_DIR=data/documents_inbox
MISA_DOCUMENTS_MAX_BYTES=20971520
# hybrid (default) | docs_first | docs_only
# hybrid = document-primary answer + live web complement when useful
MISA_DOCUMENTS_WEB_MODE=hybrid
# Drop weak retrieval hits (0–1 cosine / overlap). Default 0.12
# MISA_DOCUMENTS_RETRIEVAL_MIN_SCORE=0.12

# --- Chat sessions (persistent history) ---
MISA_SESSIONS_ENABLED=true
# memory | postgres
MISA_SESSIONS_BACKEND=postgres
MISA_SESSIONS_PROMPT_HISTORY_TURNS=6
MISA_SESSIONS_PROMPT_ASSISTANT_CHARS=400
MISA_SESSIONS_IDLE_ARCHIVE_DAYS=90
MISA_SESSIONS_HARD_DELETE_DAYS=365

# --- OpenAI / Azure model tiers ---
# OPENAI_MODEL=gpt-4o-mini
# MISA_ADVISORY_OPENAI_MODEL=gpt-4o
# When using Azure, set a distinct advisory deployment for deep writing:
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_ADVISORY_DEPLOYMENT=gpt-4o
